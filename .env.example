# URL pública del sitio (sin barra final).
# En producción, por ejemplo: https://vertice.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integración del formulario de contacto.
# Sin CONTACT_WEBHOOK_URL, la web funciona en modo demostración y NO envía datos:
# el formulario lo indica y la API responde 503 con el código NOT_CONFIGURED.
# El webhook debe aceptar un POST JSON y responder 2xx cuando acepte el mensaje.
CONTACT_WEBHOOK_URL=
# Opcional. Si se define, se envía como cabecera Authorization: Bearer <token>.
# Es un secreto de servidor: no debe llevar prefijo NEXT_PUBLIC_.
CONTACT_WEBHOOK_TOKEN=
